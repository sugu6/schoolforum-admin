{
  "name": "arco-design-pro-vue",
  "description": "海语校园论坛后台",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "ArcoDesign Team",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm exec vite --config ./config/vite.config.dev.ts",
    "build": "pnpm exec vue-tsc --noEmit && pnpm exec vite build --config ./config/vite.config.prod.ts",
    "report": "pnpm exec cross-env REPORT=true pnpm run build",
    "preview": "pnpm run build && pnpm exec vite preview --host",
    "type:check": "pnpm exec vue-tsc --noEmit --skipLibCheck",
    "lint-staged": "pnpm exec lint-staged",
    "prepare": "pnpm exec husky",
    "security:audit": "pnpm audit --audit-level=moderate"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.vue": [
      "stylelint --fix",
      "prettier --write",
      "eslint --fix"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.55.0",
    "@vueuse/core": "^14.0.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.12",
    "echarts": "^6.0.0",
    "marked": "^18.0.3",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.0",
    "vue": "^3.5.0",
    "vue-echarts": "^8.0.0",
    "vue-i18n": "^11.0.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@arco-plugins/vite-vue": "^1.4.5",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.0",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "cross-env": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^17.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.0.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.4.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.83.0",
    "stylelint": "^17.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.1.5",
    "vite-plugin-compression": "^0.5.1",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
